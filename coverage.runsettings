<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <!-- Inclure uniquement tes modules (dll/exe) générés par ta solution -->
            <ModulePaths>
              <Include>
                <ModulePath>.*\.(exe|dll)</ModulePath>
              </Include>
              <Exclude>
                <!-- runtime & libs système -->
                <ModulePath>.*\\vcruntime.*</ModulePath>
                <ModulePath>.*\\msvcp.*</ModulePath>
                <ModulePath>.*\\windows\\system32\\.*</ModulePath>
                <!-- gtest & autres externes -->
                <ModulePath>.*\\gtest.*</ModulePath>
                <ModulePath>.*\\gmock.*</ModulePath>
                <ModulePath>.*\\googletest.*</ModulePath>
                <ModulePath>.*\\vcpkg\\.*</ModulePath>
                <ModulePath>.*\\Windows\\.*</ModulePath>
                <ModulePath>.*\\Microsoft Visual Studio\\.*</ModulePath>
              </Exclude>
            </ModulePaths>

            <Sources>
              <Exclude>
                <!-- les fichiers de tests et main de la DLL sont à éliminer -->
                <Source>.*\\test_.*\.cpp</Source>
                <Source>.*\\Tests_CPU\\.*</Source>
                <Source>.*\\main.cpp</Source>
                <!-- runtime & libs système (s'il reste des reliquat du Module Path) -->
                <ModulePath>.*\\vcruntime.*</ModulePath>
                <ModulePath>.*\\msvcp.*</ModulePath>
                <ModulePath>.*\\windows\\system32\\.*</ModulePath>
                <!-- gtest & autres externes (s'il reste des reliquat du Module Path) -->
                <Source>.*\\gtest.*</Source>
                <Source>.*\\gmock.*</Source>
                <Source>.*\\googletest.*</Source>
                <Source>.*\\vcpkg\\.*</Source>
                <Source>.*\\Windows\\.*</Source>
                <Source>.*\\Microsoft Visual Studio\\.*</Source>
              </Exclude>
            </Sources>

            <!-- Exclure GoogleTest par nom de fonction (C++ natif) -->
            <Functions>
              <Exclude>
                <Function>^testing::.*</Function>
                <Function>^::testing::.*</Function>
                <Function>.*\btesting(_internal)?\b.*</Function>
              </Exclude>
            </Functions>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
